{
    "name": "football-stats",
    "version": "3.7.2",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "build-only": "vite build",
        "build": "run-p type-check \"build-only {@}\" --",
        "build:e2e": "vite build --mode staging",
        "dev": "vite",
        "knip": "knip",
        "lint:eslint": "eslint . --fix",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint": "run-s lint:*",
        "prettier": "prettier --write src/",
        "prettier:check": "prettier --check src/",
        "preview": "vite preview",
        "type-check": "vue-tsc --build",
        "typecheck": "vue-tsc --noEmit --skipLibCheck --project tsconfig.app.json",
        "test": "playwright test"
    },
    "dependencies": {
        "@iconify-json/lucide": "^1.2.127",
        "@nuxt/ui": "^4.11.0",
        "@tanstack/vue-table": "^8.21.3",
        "@vueuse/core": "^14.4.0",
        "dayjs": "^1.11.23",
        "firebase": "^12.18.0",
        "pinia": "^3.0.3",
        "vue": "^3.5.41",
        "vue-i18n": "^11.4.9"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@nabla/vite-plugin-eslint": "^3.0.1",
        "@playwright/test": "^1.62.1",
        "@prettier/plugin-oxc": "^0.2.2",
        "@tsconfig/node22": "^22.0.6",
        "@types/node": "^25.9.5",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitejs/plugin-vue-jsx": "^5.0.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.6.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.9.0",
        "eslint-plugin-oxlint": "^1.79.0",
        "eslint-plugin-vue": "^10.10.0",
        "jiti": "^2.4.2",
        "knip": "^6.33.0",
        "npm-run-all2": "^8.0.4",
        "oxlint": "^1.22.0",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-attributes": "^1.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.1.13",
        "typescript": "^5.9.3",
        "vite": "npm:rolldown-vite@latest",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vue-router": "^5.3.0",
        "vue-tsc": "^3.3.11"
    },
    "overrides": {
        "@ianvs/prettier-plugin-sort-imports": {
            "@prettier/plugin-oxc": "$@prettier/plugin-oxc"
        }
    }
}
