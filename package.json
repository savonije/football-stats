{
    "name": "football-stats",
    "version": "3.24.1",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^26.0.0"
    },
    "scripts": {
        "build-only": "vp build",
        "build": "run-p type-check \"build-only {@}\" --",
        "build:e2e": "vp build --mode emulator",
        "check": "vp check",
        "dev": "vp dev",
        "fmt": "vp fmt",
        "fmt:check": "vp fmt --check",
        "emulators": "firebase emulators:start --only auth,firestore --project demo-football-stats",
        "knip": "knip",
        "lint": "vp lint --fix",
        "preview": "vp preview",
        "type-check": "vue-tsc --build",
        "test": "playwright test",
        "test:unit": "vp test run",
        "prepare": "vp config"
    },
    "dependencies": {
        "@iconify-json/lucide": "^1.2.151",
        "@nuxt/ui": "^4.12.0",
        "@tanstack/vue-table": "^8.21.3",
        "@tiptap/extension-table": "^3.33.0",
        "@vueuse/core": "^15.0.0",
        "dayjs": "^1.11.23",
        "firebase": "^13.2.0",
        "pinia": "^4.1.0",
        "vue": "^3.5.45",
        "vue-i18n": "^11.4.18"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.0",
        "@tsconfig/node26": "^26.0.1",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "firebase-tools": "^15.35.0",
        "knip": "^6.44.1",
        "npm-run-all2": "^9.0.3",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vite-plus": "1.5.0",
        "vue-router": "^5.4.0",
        "vue-tsc": "^3.3.14"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "@grpc/grpc-js": "^1.14.0",
        "superstatic": "^11.1.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=11.13.0",
            "onFail": "download"
        }
    },
    "allowScripts": {
        "@firebase/util": false,
        "vue-demi": false,
        "esbuild": false,
        "protobufjs": false,
        "re2": false,
        "fsevents": false
    }
}
