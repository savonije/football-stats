# `vp build --mode emulator`: the e2e build. A `demo-` project needs no Firebase
# project or credentials, and the app talks only to the local emulators.
VITE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-football-stats
VITE_FIREBASE_APIKEY=demo-api-key
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_MESSAGE_SENDER_ID=0
VITE_FIREBASE_STORAGE_BUCKET=demo-football-stats.appspot.com
VITE_CLUBNAME=FC Demo
